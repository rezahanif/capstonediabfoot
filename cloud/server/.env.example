# Insole Cloud — server configuration
# Copy to .env and fill in. Never commit the filled file.

# PostgreSQL connection string (schema: ../schema.sql)
DATABASE_URL=postgres://insole:change-me@localhost:5432/insole

# HMAC secret for the app JWTs — generate: openssl rand -hex 32
JWT_SECRET=change-me

# Your Google OAuth Android client ID (the mobile app's ID token audience)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Google OAuth **Web** client ID for the doctor web app (optional until the
# web console goes live; either this or GOOGLE_CLIENT_ID must be set)
GOOGLE_WEB_CLIENT_ID=

# Exact origin the doctor web SPA is served from (enables CORS).
# Empty = no CORS headers. Dev example: http://localhost:5173
WEB_ORIGIN=

# Listen address (put a TLS reverse proxy in front; never expose HTTP)
ADDR=:8080
